# --- Required in production (set these as Space secrets) ---
# Hosted Postgres, for example a Neon connection string. Without it the app uses a local SQLite file.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string that signs sign-in tokens and email links. Without it everyone is signed out on every restart.
SECRET_KEY=change-me-to-a-long-random-string
# The first admin account, created only when no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- AI ---
# Groq: expert chat and explanations
GROQ_API_KEY=gsk_your_key_here
# Gemini: decides whether an upload is a wafer map (rejects photos, X-rays, faces)
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Access request emails (see apps_script_mail_relay.gs) ---
MAIL_RELAY_URL=https://script.google.com/macros/s/XXXX/exec
MAIL_RELAY_TOKEN=same-value-as-RELAY_TOKEN-in-the-script
# Where new requests are sent for approval
ADMIN_NOTIFY_EMAIL=you@example.com
# Used to build the links in those emails
FRONTEND_URL=https://your-frontend.vercel.app
API_PUBLIC_URL=https://your-space.hf.space

# Comma-separated list of allowed frontend origins. Use "*" for local dev.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
